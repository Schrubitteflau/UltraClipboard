{
  "$schema": "../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UltraClipboard",
  "identifier": "org.ultraclipboard.UltraClipboard",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UltraClipboard",
        "width": 720,
        "height": 520,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
